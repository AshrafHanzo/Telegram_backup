{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.telegramdrive.mobile",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-sharing",
      "expo-image",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Telegram Drive needs access to your photos so you can upload them to your Telegram-backed folders."
        }
      ],
      "expo-background-task",
      "@react-native-google-signin/google-signin",
      "expo-video",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Telegram Drive uses Face ID to unlock the app instead of typing your App Lock password."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "newArchEnabled": false
          },
          "ios": {
            "newArchEnabled": false
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b1461674-e9da-42f7-a21a-0bab148713a4"
      }
    }
  }
}
